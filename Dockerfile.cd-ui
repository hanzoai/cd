# hanzoai/cd-ui — the Hanzo CD dashboard SPA, served by hanzoai/spa.
#
# Builds the Hanzo CD React UI (base-href /) and serves it via
# ghcr.io/hanzoai/spa (Go static server, :3000, ROOT=/public, SPA
# history-fallback). Deployed as the `cd-ui` App CR at cd.hanzo.ai/.
#
# The build stage mirrors the argocd-ui stage in ./Dockerfile — same node
# digest, same pnpm/corepack recipe, one place to bump each.
FROM --platform=$BUILDPLATFORM docker.io/library/node:24.17.0@sha256:032e78d7e54e352129831743737e3a83171d9cc5b5896f411649c597ce0b11ea AS build

WORKDIR /src
COPY ["ui/package.json", "ui/pnpm-lock.yaml", "./"]

RUN npm install -g corepack@0.34.6 && corepack enable && pnpm install --frozen-lockfile

COPY ["ui/", "."]

ARG ARGO_VERSION=latest
ENV ARGO_VERSION=$ARGO_VERSION
# Fail hard on a placeholder bundle: the build must emit a real index.html.
RUN NODE_ENV='production' NODE_ONLINE_ENV='online' NODE_OPTIONS=--max_old_space_size=8192 pnpm build \
    && [ -s dist/app/index.html ]

# hanzoai/spa serves /public at :3000 with SPA history-fallback + a sane CSP.
FROM ghcr.io/hanzoai/spa:1.2.0
COPY --from=build /src/dist/app /public
EXPOSE 3000
