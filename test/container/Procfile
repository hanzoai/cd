controller: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/argocd || COMMAND='go run ./cmd/main.go' && sh -c "[ -f /tmp/argocd-e2e-env ] && . /tmp/argocd-e2e-env; FORCE_LOG_COLORS=1 CD_FAKE_IN_CLUSTER=true CD_TLS_DATA_PATH=${CD_TLS_DATA_PATH:-/tmp/argocd-local/tls} CD_SSH_DATA_PATH=${CD_SSH_DATA_PATH:-/tmp/argocd-local/ssh} CD_BINARY_NAME=argocd-application-controller $COMMAND --loglevel debug --redis localhost:${CD_E2E_KV_PORT:-6379} --repo-server localhost:${CD_E2E_REPOSERVER_PORT:-8081} --commit-server localhost:${CD_E2E_COMMITSERVER_PORT:-8086} --application-namespaces=${CD_APPLICATION_NAMESPACES:-''}"
api-server: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/argocd || COMMAND='go run ./cmd/main.go' && sh -c "FORCE_LOG_COLORS=1 CD_FAKE_IN_CLUSTER=true CD_BINARY_NAME=argocd-server $COMMAND --loglevel debug --redis localhost:${CD_E2E_KV_PORT:-6379} --disable-auth=${CD_E2E_DISABLE_AUTH:-'true'} --insecure --dex-server http://localhost:${CD_E2E_DEX_PORT:-5556} --repo-server localhost:${CD_E2E_REPOSERVER_PORT:-8081} --port ${CD_E2E_APISERVER_PORT:-8080} --application-namespaces=${CD_APPLICATION_NAMESPACES:-''} "
dex: sh -c "test $CD_IN_CI = true && exit 0; CD_BINARY_NAME=argocd-dex go run github.com/hanzoai/cd/cmd gendexcfg -o `pwd`/dist/dex.yaml && docker run --rm -p ${CD_E2E_DEX_PORT:-5556}:${CD_E2E_DEX_PORT:-5556} -v `pwd`/dist/dex.yaml:/dex.yaml ghcr.io/dexidp/dex:v2.45.0 serve /dex.yaml" # renovate: datasource=github-releases depName=dexidp/dex
redis: sh -c "/usr/local/bin/redis-server --save "" --appendonly no --port ${CD_E2E_KV_PORT:-6379}"
repo-server: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/argocd || COMMAND='go run ./cmd/main.go' && sh -c "FORCE_LOG_COLORS=1 CD_FAKE_IN_CLUSTER=true CD_GNUPGHOME=${CD_GNUPGHOME:-/tmp/argocd-local/gpg/keys} CD_PLUGINSOCKFILEPATH=${CD_PLUGINSOCKFILEPATH:-./test/cmp}  CD_GPG_DATA_PATH=${CD_GPG_DATA_PATH:-/tmp/argocd-local/gpg/source} CD_BINARY_NAME=argocd-repo-server $COMMAND --loglevel debug --port ${CD_E2E_REPOSERVER_PORT:-8081} --redis localhost:${CD_E2E_KV_PORT:-6379}"
commit-server: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/argocd || COMMAND='go run ./cmd/main.go' && sh -c "FORCE_LOG_COLORS=1 CD_BINARY_NAME=argocd-commit-server $COMMAND --loglevel debug --port ${CD_E2E_COMMITSERVER_PORT:-8086}"
ui: sh -c "test $CD_IN_CI = true && exit 0; cd ui && CD_E2E_JS_HOST=0.0.0.0 ${CD_E2E_PNPM_CMD:-pnpm} start"
reaper: ./test/container/reaper.sh
sshd: sudo sh -c "test $CD_E2E_TEST = true && /usr/sbin/sshd -p 2222 -D -e"
fcgiwrap: sudo sh -c "test $CD_E2E_TEST = true && (fcgiwrap -s unix:/var/run/fcgiwrap.socket & sleep 1 && chmod 777 /var/run/fcgiwrap.socket && wait)"
nginx: sudo sh -c "test $CD_E2E_TEST = true && nginx -g 'daemon off;' -c $(pwd)/test/fixture/testrepos/nginx.conf"
helm-registry: sudo sh -c "OTEL_TRACES_EXPORTER=none REGISTRY_LOG_LEVEL=info registry serve /etc/docker/registry/config.yml"
dev-mounter: test "$CD_E2E_TEST" != "true" && go run hack/dev-mounter/main.go --configmap argocd-ssh-known-hosts-cm=${CD_SSH_DATA_PATH:-/tmp/argocd-local/ssh} --configmap argocd-tls-certs-cm=${CD_TLS_DATA_PATH:-/tmp/argocd-local/tls} --configmap argocd-gpg-keys-cm=${CD_GPG_DATA_PATH:-/tmp/argocd-local/gpg/source}
applicationset-controller: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/argocd || COMMAND='go run ./cmd/main.go' && sh -c "FORCE_LOG_COLORS=4 CD_FAKE_IN_CLUSTER=true CD_APPLICATIONSET_CONTROLLER_ENABLE_PROGRESSIVE_SYNCS=${CD_APPLICATIONSET_CONTROLLER_ENABLE_PROGRESSIVE_SYNCS:-true} CD_TLS_DATA_PATH=${CD_TLS_DATA_PATH:-/tmp/argocd-local/tls} CD_SSH_DATA_PATH=${CD_SSH_DATA_PATH:-/tmp/argocd-local/ssh} CD_BINARY_NAME=argocd-applicationset-controller $COMMAND --loglevel debug --metrics-addr localhost:12345 --probe-addr localhost:12346 --argocd-repo-server localhost:${CD_E2E_REPOSERVER_PORT:-8081}"
notification: sh -c "FORCE_LOG_COLORS=4 CD_FAKE_IN_CLUSTER=true CD_TLS_DATA_PATH=${CD_TLS_DATA_PATH:-/tmp/argocd-local/tls} CD_BINARY_NAME=argocd-notifications go run ./cmd/main.go --loglevel debug"
